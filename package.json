{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "oxfmt '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "oxfmt --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "oxlint --max-warnings=0",
    "release": "turbo run build --filter=@primer/agent-eval && changeset publish",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "1.65.0",
    "rolldown": "^1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
