{
  "name": "@primer/agent-eval",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "agent-eval": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && rolldown -c && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "watch": "rolldown -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/agent-eval.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/primer/agent-eval/issues"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@primer/agent-evals": "workspace:*",
    "@primer/agent-experiment": "workspace:*",
    "@primer/agent-experiments": "workspace:*",
    "@primer/agent-sandbox": "workspace:*",
    "@types/node": "^24.12.4",
    "rimraf": "^6.1.3",
    "rolldown": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
