#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

corepack enable
corepack install

# Install dependencies
pnpm install --frozen-lockfile

# Download the 10 most recent retained baseline result bundles.
artifact_ids="$(
  gh api \
    --paginate \
    --slurp \
    "/repos/primer/agent-eval/actions/artifacts?per_page=100" |
    jq --raw-output '
      [.[].artifacts[]
        | select(.expired == false and (.name | test("^baseline-[0-9]+$")))
      ]
      | sort_by(.created_at)
      | .[-10:][].id
    '
)"

if [[ -n "$artifact_ids" ]]; then
  download_directory="$(mktemp -d)"
  trap 'rm -rf "$download_directory"' EXIT

  while IFS= read -r artifact_id; do
    archive="$download_directory/$artifact_id.zip"
    gh api \
      "/repos/primer/agent-eval/actions/artifacts/$artifact_id/zip" \
      > "$archive"
    unzip -o -q "$archive" -d "$download_directory"
  done <<< "$artifact_ids"

  mkdir -p "$repository_root/results"
  cp -R "$download_directory/results/." "$repository_root/results/"
fi

# Build
pnpm --dir "$repository_root" run build
