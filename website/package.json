  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/agent-eval.git",
    "directory": "website"
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/test",
    "!src/test-fixtures.ts",
    "runtime.js",
    "runtime.d.ts",
    "tsconfig.json",
    "postcss.config.js"
  ],
  "exports": {
    "./runtime": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    },
    "./runtime.js": {
      "types": "./runtime.d.ts",
      "default": "./runtime.js"
    }
  },
  "scripts": {
    "build": "next build",
    "clean": "rimraf .next",
    "dev": "next dev",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@primer/agent-eval": "workspace:*",
    "@primer/octicons-react": "^19.33.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.32.0",
    "@primer/tailwind-config": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "~26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "next": "^16.3.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "dependenciesMeta": {
