{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx}' --max-warnings=0 --cache",
    "release": "turbo run build --filter=@primer/agent-eval && changeset publish",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@github/prettier-config": "^0.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.13.0",
    "eslint-plugin-github": "^6.1.2",
    "globals": "^17.12.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.16",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
