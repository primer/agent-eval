#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

corepack enable
corepack install

# Install dependencies
pnpm install --frozen-lockfile

# Download the latest baseline results
run_id="$(
  gh run list \
    --repo primer/agent-eval \
    --workflow baseline.yml \
    --status success \
    --limit 1 \
    --json databaseId \
    --jq '.[0].databaseId // empty'
)"

if [[ -n "$run_id" ]]; then
  download_directory="$(mktemp -d)"
  trap 'rm -rf "$download_directory"' EXIT

  gh run download \
    --repo primer/agent-eval \
    "$run_id" \
    --name "baseline-$run_id" \
    --dir "$download_directory"

  mkdir -p "$repository_root/results"
  cp -R "$download_directory/results/." "$repository_root/results/"
fi

# Build
pnpm --dir "$repository_root" run build
