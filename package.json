{
  "name": "@primer/agent-eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx,md,mdx}' --max-warnings=0 --cache",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/agent-eval.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/primer/agent-eval/issues"
  },
  "devDependencies": {
    "@github/prettier-config": "^0.0.6",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.4",
    "eslint-plugin-github": "^6.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rolldown": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
