{
  "name": "@primer/agent-eval-core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "default": "./dist/benchmark.js"
    },
    "./experiment": {
      "types": "./dist/experiment.d.ts",
      "default": "./dist/experiment.js"
    },
    "./package.json": "./package.json",
    "./sandbox/glob-script": "./dist/sandbox/glob-script.mjs",
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "clean": "rimraf dist",
    "lint:npm": "publint --types",
    "type-check": "tsc --noEmit",
    "watch": "rolldown -c -w"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "glob": "^13.0.6",
    "memfs": "^4.68.1",
    "p-queue": "^9.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "tar-fs": "^3.1.2",
    "tar-stream": "^3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.13",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "^6.0.3"
  }
}
