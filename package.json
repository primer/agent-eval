{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx}' --max-warnings=0 --cache",
    "test": "vitest",
    "type-check": "tsc --noEmit && pnpm --recursive run type-check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@github/prettier-config": "^0.0.6",
    "@types/node": "^24.12.4",
    "eslint": "^9.39.4",
    "eslint-plugin-github": "^6.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rolldown": "^1.0.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
