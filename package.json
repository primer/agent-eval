{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx}' --max-warnings=0 --cache",
    "release": "pnpm --filter @primer/agent-eval run build && changeset publish",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "10.0.1",
    "@github/prettier-config": "^0.0.6",
    "@primer/agent-eval": "workspace:*",
    "@types/node": "^26.4.0",
    "eslint": "^10.10.0",
    "eslint-plugin-github": "^6.1.2",
    "globals": "^17.12.0",
    "playwright": "1.62.1",
    "prettier": "^3.8.3",
    "rolldown": "^1.2.9",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
