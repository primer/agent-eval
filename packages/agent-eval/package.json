{
  "name": "@primer/agent-eval",
  "version": "0.4.0",
  "type": "module",
  "bin": {
    "agent-eval": "bin/agent-eval"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./experiment": {
      "types": "./dist/experiment.d.ts",
      "default": "./dist/experiment.js"
    },
    "./experiments": {
      "types": "./dist/experiments.d.ts",
      "default": "./dist/experiments.js"
    },
    "./output": {
      "types": "./dist/output.d.ts",
      "default": "./dist/output.js"
    },
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c",
    "clean": "rimraf dist",
    "lint:npm": "publint --types",
    "type-check": "tsc --noEmit",
    "watch": "rolldown -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/agent-eval.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/primer/agent-eval/issues"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "tar-fs": "^3.1.2",
    "tar-stream": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.2.0",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.6",
    "rolldown-plugin-dts": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
