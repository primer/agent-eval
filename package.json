{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx}' --max-warnings=0 --cache",
    "test": "vitest",
    "type-check": "tsc --noEmit && pnpm --recursive run type-check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@github/prettier-config": "^0.0.6",
    "@types/node": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-github": "^6.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rolldown": "^1.1.0",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
