{
  "name": "@primer/agent-eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "turbo run format:diff:root",
    "format:diff:root": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "turbo run lint:js lint:npm",
    "lint:js": "eslint '**/*.{js,ts,tsx}' --max-warnings=0 --cache",
    "lint:md": "turbo run lint:md:root",
    "lint:md:root": "prettier --check '**/*.{md,mdx}'",
    "release": "pnpm --filter @primer/agent-eval run build && changeset publish",
    "test": "vitest",
    "type-check": "turbo run type-check type-check:root",
    "type-check:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "10.0.1",
    "@github/prettier-config": "^0.0.6",
    "@primer/agent-eval": "workspace:*",
    "@types/node": "^26.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-github": "^6.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rolldown": "^1.1.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
