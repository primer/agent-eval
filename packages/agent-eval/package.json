{
  "name": "@primer/agent-eval",
  "version": "0.16.0",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "docs"
  ],
  "bin": {
    "agent-eval": "bin/agent-eval"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "default": "./dist/benchmark.js"
    },
    "./experiment": {
      "types": "./dist/experiment.d.ts",
      "default": "./dist/experiment.js"
    },
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "rolldown -c",
    "clean": "rimraf dist",
    "dev:ui": "next dev src/ui",
    "lint:npm": "publint --types",
    "type-check": "tsc --noEmit",
    "watch": "rolldown -c -w"
  },
  "dependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "citty": "^0.2.2",
    "cpu-features": "^0.0.10",
    "dockerode": "^5.0.1",
    "glob": "^13.0.6",
    "memfs": "^4.68.1",
    "next": "^16.4.0",
    "p-queue": "^9.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar-fs": "^3.1.2",
    "tar-stream": "^3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.4",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.13",
    "rolldown-plugin-dts": "^0.28.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/agent-eval.git"
  },
  "bugs": {
    "url": "https://github.com/primer/agent-eval/issues"
  }
}
